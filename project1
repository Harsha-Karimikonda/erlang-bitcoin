#!/usr/bin/env bash
# Ensure Erlang is in PATH
if ! command -v escript >/dev/null 2>&1; then
    if [ -x "$HOME/.local/erlang/bin/escript" ]; then
        export PATH="$HOME/.local/erlang/bin:$PATH"
    elif [ -x "/opt/homebrew/bin/escript" ]; then
        export PATH="/opt/homebrew/bin:$PATH"
    elif [ -x "/usr/local/bin/escript" ]; then
        export PATH="/usr/local/bin:$PATH"
    fi
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec escript "$SCRIPT_DIR/project1.escript" "$@"

